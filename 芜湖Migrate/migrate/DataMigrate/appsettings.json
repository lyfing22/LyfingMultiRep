{
  // 数据源类型标识，DI 按此 Key 解析 IMigrationSource 等不同源数据厂商实现
  "SourceType": "Neusoft",
  "ConnectionStrings": {
    // 旧厂商 PACS 源库连接串（Fetch Size 设大值以优化分页吞吐）
    "Source": "User Id=test;Password=test;Data Source=192.168.3.86/PACS;Connection Timeout=60;Fetch Size=131072;",
    // SQL Server 日志追踪库（仅 ZTemp_MigratePlan / ZTemp_MigrateError 两张表）
    "Destination": "server=192.168.1.166\\HINADB;database=miPlatform_MIIS;User=sa;Password=Hin@c0m;Connect Timeout=60;",
    // MongoDB 目标库，仅 validate / audit 模式使用，数据库 MIIS_Archive，集合 archive.migrate
    "MongoDB": "mongodb://ris_admin:hinacom@192.168.1.166:27017?serverSelectionTimeoutMS=5000"
  },
  "Migration": {
    "Mode": "batch",           // batch | debug | validate | audit
    "AccessionNumber": "",     // debug 模式：配置此项则查单条；否则按 TimeRange 区间迁移
    "TimeRange": {
      "Start": "2024-01-01",  // debug 模式（无 AccessionNumber 时）使用，按区间切分计划迁移
      "End": "2024-06-09"
    },
    "PlanIntervalDays": 1,     // 计划切割天数间隔（默认 1 天）
    "MaxParallelPlans": 2,     // 最大同时执行的计划数
    "PlanOrder": "descending", // 计划执行顺序：descending（从新到旧）| ascending（从旧到新）
    "ChannelCapacity": 200,    // 内存队列容量，控制背压阈值
    "Parallelism": 4,          // 并行 HTTP 上传的消费者数
    "ZTempBatchSize": 100,     // ZTemp 表的批量写入缓冲区大小（攒够后一次 MERGE）
    "DbFlag": "DB_FSK"         // 业务标识，部分厂商超声放射分多个库,写入 ZTemp 表以区分不同迁移批次
  },
  "Upload": {
    "Url": "http://192.168.1.166:10081/api/Archive",  // MIIS Archive HTTP API 地址
    "JwtAppId": "RIS",         // JWT 签发应用 ID（合法值: MIIS/RIS/PACS/MPACS/USES）
    "JwtAppSecret": "f70f3531be9b4f81bfd148823cbddd04", // JWT 签名密钥
    "JwtExpiryMinutes": 40,    // Token 有效期（分钟），Timer 提前 5 分钟自动刷新
    "TimeoutSeconds": 30       // HTTP 请求超时时间(秒)
  },
  "Identity": {
    "StorageNode": "HINAMIISFBS", // 影像存储节点名
    "ServerNode": "HINAMIIS",     // 服务器节点名，写入 JWT 的 username claim
    "HospitalCode": "Hinacom",    // 医院代码
    "HospitalName": "空总医院"     // 医院名称
  },
  // 设备类型 → 执行科室映射（用于填充 OrderArchive.ExecDepartmentCode/Name）
  "ModalityDepartment": {
    "CT": { "ExecDepartmentCode": "704", "ExecDepartmentName": "放射科" },
    "MR": { "ExecDepartmentCode": "704", "ExecDepartmentName": "放射科" },
    "XA": { "ExecDepartmentCode": "704", "ExecDepartmentName": "放射科" },
    "CR": { "ExecDepartmentCode": "704", "ExecDepartmentName": "放射科" },
    "DX": { "ExecDepartmentCode": "704", "ExecDepartmentName": "放射科" }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      // 日志文件路径: logs/migrate-{yyyyMMdd}.log，保留最近 30 天
      { "Name": "File", "Args": { "path": "logs/migrate-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ]
  }
